# ---- Public (safe to expose to the browser) ----
# Supabase project URL and anon (public) key: Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# The public HTTPS address of this app (used inside QR codes and password-reset links)
NEXT_PUBLIC_APP_URL=https://gzx-loyalty.vercel.app

# ---- Server only (NEVER prefix with NEXT_PUBLIC_) ----
# Used only by the staff-management server actions to create staff logins.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
